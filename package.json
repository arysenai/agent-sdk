{
  "name": "@arysenai/agent-sdk",
  "version": "0.3.1",
  "description": "Arysen Agent SDK — TypeScript wrapper for keymod WASM modules",
  "type": "module",
  "main": "dist/keymod/index.js",
  "types": "dist/keymod/index.d.ts",
  "exports": {
    "./keymod": {
      "import": "./dist/keymod/index.js",
      "types": "./dist/keymod/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:keychain": "tsx test-keychain-persistence.ts"
  },
  "dependencies": {
    "@arysenai/arysen-mandate": "^0.3.2",
    "@arysenai/arysen-wallet": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@arysenai/arysen-mandate": "file:../keymod/mandate/pkg"
    }
  }
}
