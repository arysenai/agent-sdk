{
  "name": "@arysenai/agent-sdk",
  "version": "0.1.0",
  "description": "Arysen Agent SDK — TypeScript wrapper for keymod WASM modules",
  "type": "module",
  "main": "dist/keymod/index.js",
  "types": "dist/keymod/index.d.ts",
  "exports": {
